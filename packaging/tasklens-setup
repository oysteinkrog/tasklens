#!/bin/sh
# tasklens-setup: the root steps of the Additional Setup window (E29-022, E29-023,
# R-138 item 11).
# The window runs it as `pkexec /usr/lib/tasklens/tasklens-setup <subcommand>`.
# Fixed paths only. Nothing is written to /tmp. /etc/udev/rules.d/99-powercap.rules is never
# read, written or removed (R-029).
#
# Test mode: when not root and TASKLENS_SETUP_ROOT is set, every path is under that root and
# external commands are printed as "would run: ..." instead of run. As root the variable is
# ignored (R-168 E29-OI-13).
set -eu
umask 022
PATH=/usr/bin:/bin
export PATH
# Byte ranges in the module name check, whatever the caller's locale.
LC_ALL=C
export LC_ALL

RULE='SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", ACTION=="add", RUN+="/usr/bin/chmod 0444 /sys%p/energy_uj"'
USAGE='usage: tasklens-setup rapl-enable|rapl-revert|sensors-detect|sensors-revert|polkit-rule on|off|linger on|off|remote-admin on|off|state'

if [ "$(id -u)" -eq 0 ]; then
    ROOT=""
    TEST=0
elif [ -n "${TASKLENS_SETUP_ROOT-}" ]; then
    ROOT="$TASKLENS_SETUP_ROOT"
    TEST=1
else
    echo 'tasklens-setup: must run as root (use pkexec)' >&2
    exit 1
fi

RULES_DIR="$ROOT/etc/udev/rules.d"
MODULES_DIR="$ROOT/etc/modules-load.d"
LM_CONF="$ROOT/etc/conf.d/lm_sensors"
# What sensors-detect changed, saved before the first run and used by sensors-revert.
STATE_DIR="$ROOT/var/lib/tasklens"
SAVED="$STATE_DIR/sensors-saved"
SAVED_CONF="$STATE_DIR/lm_sensors.before"
SAVED_ENABLED="$STATE_DIR/lm_sensors-service.enabled"
POLKIT_RULE="$ROOT/etc/polkit-1/rules.d/49-tasklens.rules"
REMOTE_ADMIN_RULE="$ROOT/etc/polkit-1/rules.d/49-tasklens-remote-admin.rules"

# Runs an external system command, or prints it in test mode.
run() {
    if [ "$TEST" -eq 1 ]; then
        echo "would run: $*"
    else
        "$@"
    fi
}

udev_reload() {
    run udevadm control --reload
    run udevadm trigger --subsystem-match=powercap --action=add
}

rapl_enable() {
    tmp="$RULES_DIR/99-tasklens-powercap.rules.tmp"
    printf '%s\n' "$RULE" > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$RULES_DIR/99-tasklens-powercap.rules"
    udev_reload
    echo 'Enabled'
}

rapl_revert() {
    rm -f "$RULES_DIR/99-tasklens-powercap.rules"
    udev_reload
    echo 'Reverted. A reboot may be needed before the files return to mode 0400.'
}

# Runs `sensors-detect --auto`. In test mode prints `$ROOT/sensors-detect.out` and, when
# `$ROOT/sensors-detect.conf` exists, copies it to the conf.d file as sensors-detect would.
sensors_detect_output() {
    if [ "$TEST" -eq 1 ]; then
        echo 'would run: sensors-detect --auto'
        cat "$ROOT/sensors-detect.out"
        if [ -f "$ROOT/sensors-detect.conf" ]; then
            cp "$ROOT/sensors-detect.conf" "$LM_CONF"
        fi
    else
        sensors-detect --auto
    fi
}

# True when lm_sensors.service is enabled. In test mode, when `$ROOT/lm_sensors.enabled` exists.
service_enabled() {
    if [ "$TEST" -eq 1 ]; then
        echo 'would run: systemctl is-enabled --quiet lm_sensors.service'
        [ -e "$ROOT/lm_sensors.enabled" ]
    else
        systemctl is-enabled --quiet lm_sensors.service
    fi
}

# Saves what sensors-detect may change: a copy of the conf.d file if there is one, and whether
# lm_sensors.service is enabled. A second run before a revert keeps the first saved state.
save_sensors_state() {
    [ ! -e "$SAVED" ] || return 0
    mkdir -p "$STATE_DIR"
    rm -f "$SAVED_CONF" "$SAVED_ENABLED"
    if [ -f "$LM_CONF" ]; then
        cp -p "$LM_CONF" "$SAVED_CONF"
    fi
    if service_enabled; then
        : > "$SAVED_ENABLED"
    fi
    : > "$SAVED"
}

# Adds `$1` to `$modules` when it is a name of letters, digits, `_` and `-`.
add_module() {
    case $1 in
        '' | *[!A-Za-z0-9_-]*) printf 'skipped module name: %s\n' "$1" ;;
        *) modules="$modules$1$nl" ;;
    esac
}

# Adds each space-separated name in `$1`, after removing the quotes around the whole value.
add_modules_value() {
    value=$1
    case $value in
        \"*\") value=${value#\"}; value=${value%\"} ;;
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    IFS=' '
    for name in $value; do
        add_module "$name"
    done
    IFS=$nl
}

# PERF-108: writes the modules sensors-detect finds to modules-load.d and loads them.
# sensors-detect 3.6 reports them in one of two ways. When /etc/conf.d exists it writes
# BUS_MODULES and HWMON_MODULES to /etc/conf.d/lm_sensors, and may enable and start
# lm_sensors.service. Otherwise it prints `modprobe <name>` lines between two
# "#----cut here----" lines.
sensors_detect() {
    if [ ! -f "$ROOT/usr/bin/sensors-detect" ]; then
        echo 'Install lm_sensors to detect fan sensors'
        exit 3
    fi
    save_sensors_state
    # The conf.d file as it was before this run, to tell whether this run wrote it.
    run_conf="$STATE_DIR/lm_sensors.run"
    rm -f "$run_conf"
    if [ -f "$LM_CONF" ]; then
        cp "$LM_CONF" "$run_conf"
    fi
    status=0
    out=$(sensors_detect_output) || status=$?
    printf '%s\n' "$out"
    written=0
    if [ -f "$LM_CONF" ] && { [ ! -f "$run_conf" ] || ! cmp -s "$LM_CONF" "$run_conf"; }; then
        written=1
    fi
    rm -f "$run_conf"
    if [ "$status" -ne 0 ]; then
        exit "$status"
    fi

    modules=''
    nl='
'
    set -f
    saved_ifs=$IFS
    IFS=$nl
    if [ "$written" -eq 1 ]; then
        # BUS_MODULES comes first in the file, the order lm_sensors.service loads them in.
        while read -r line; do
            case $line in
                BUS_MODULES=* | HWMON_MODULES=*) add_modules_value "${line#*=}" ;;
            esac
        done < "$LM_CONF"
    else
        cut=0
        for line in $out; do
            if [ "$line" = '#----cut here----' ]; then
                cut=$((1 - cut))
                continue
            fi
            [ "$cut" -eq 1 ] || continue
            case $line in
                'modprobe '*) add_modules_value "${line#modprobe }" ;;
            esac
        done
    fi
    IFS=$saved_ifs
    set +f

    if [ -z "$modules" ]; then
        echo 'No sensor modules found'
        return 0
    fi
    tmp="$MODULES_DIR/tasklens-sensors.conf.tmp"
    printf '%s' "$modules" > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$MODULES_DIR/tasklens-sensors.conf"
    set -f
    IFS=$nl
    for name in $modules; do
        # `run` prints its arguments joined by the first IFS character.
        IFS=$saved_ifs
        run modprobe "$name"
    done
    IFS=$saved_ifs
    set +f
    echo 'Enabled'
}

# Removes the module file. When detection saved state, also puts back the conf.d file as it was
# (or removes it if there was none) and disables lm_sensors.service unless it was enabled
# before. Without saved state the conf.d file and the service are left alone.
sensors_revert() {
    rm -f "$MODULES_DIR/tasklens-sensors.conf"
    if [ -e "$SAVED" ]; then
        if [ -f "$SAVED_CONF" ]; then
            cp -p "$SAVED_CONF" "$LM_CONF.tasklens.tmp"
            mv -f "$LM_CONF.tasklens.tmp" "$LM_CONF"
        else
            rm -f "$LM_CONF"
        fi
        if [ ! -e "$SAVED_ENABLED" ] && service_enabled; then
            run systemctl disable lm_sensors.service
        fi
        rm -f "$SAVED_CONF" "$SAVED_ENABLED" "$SAVED"
    fi
    echo 'Reverted. The modules stay loaded until the next reboot.'
}

# APP-049: lets wheel members in the active local session run tasklens's own polkit actions
# without a password. The prefix covers no systemd or org.freedesktop.* action.
polkit_rule_on() {
    tmp="$POLKIT_RULE.tmp"
    cat > "$tmp" <<'EOF'
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("io.github.oysteinkrog.tasklens.") == 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
EOF
    chmod 0644 "$tmp"
    mv -f "$tmp" "$POLKIT_RULE"
    echo 'Enabled'
}

polkit_rule_off() {
    rm -f "$POLKIT_RULE"
    echo 'Reverted'
}

# Exits unless PKEXEC_UID, which pkexec sets to the user who asked, is a number.
check_pkexec_uid() {
    case ${PKEXEC_UID-} in
        '' | *[!0-9]*)
            echo 'tasklens-setup: PKEXEC_UID is missing or not a number' >&2
            exit 1
            ;;
    esac
}

# Lets the user's engine service run with nobody logged in.
linger() {
    check_pkexec_uid
    run loginctl "$1-linger" "$PKEXEC_UID"
    if [ "$1" = enable ]; then echo 'Enabled'; else echo 'Reverted'; fi
}

# ADR-018 Remote root actions: lets the user who asked run tasklens's root actions with no
# password prompt, from any session, so a tasklens window on another PC can use them over ssh.
# It covers the three tasklens polkit actions, systemd's manage-units only for a single unit
# (the action has a "unit" detail) and manage-unit-files. `tasklens remote-admin on|off` runs
# this through pkexec and saves remote_admin in engine.toml itself, through the engine socket;
# this script never writes engine.toml. The command asks `remote-admin state` first and keeps
# the answer itself; to undo a failed change it runs `on` (present) or `off` (absent).
remote_admin_on() {
    check_pkexec_uid
    user=$(id -nu -- "$PKEXEC_UID" 2>/dev/null) || {
        echo "tasklens-setup: no user with uid $PKEXEC_UID" >&2
        exit 1
    }
    # The name goes into a JavaScript string, so only these characters are allowed.
    case $user in
        '' | -* | *[!A-Za-z0-9._-]*)
            echo 'tasklens-setup: the user name has characters a polkit rule cannot hold' >&2
            exit 1
            ;;
    esac
    tmp="$REMOTE_ADMIN_RULE.tmp"
    cat > "$tmp" <<EOF
polkit.addRule(function(action, subject) {
    if (subject.user != "$user") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "io.github.oysteinkrog.tasklens.helper" ||
        action.id == "io.github.oysteinkrog.tasklens.setup" ||
        action.id == "io.github.oysteinkrog.tasklens.netmon" ||
        action.id == "org.freedesktop.systemd1.manage-unit-files" ||
        (action.id == "org.freedesktop.systemd1.manage-units" && action.lookup("unit"))) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
EOF
    chmod 0644 "$tmp"
    mv -f "$tmp" "$REMOTE_ADMIN_RULE"
    echo 'Enabled'
}

remote_admin_off() {
    rm -f "$REMOTE_ADMIN_RULE"
    echo 'Reverted'
}

# Prints "present" when the rules file exists, else "absent". A user cannot read
# /etc/polkit-1/rules.d (root:polkitd 0750), so the command asks this.
remote_admin_state() {
    if [ -e "$REMOTE_ADMIN_RULE" ]; then echo 'present'; else echo 'absent'; fi
}

usage() {
    echo "$USAGE" >&2
    exit 2
}

case "${1-}" in
    rapl-enable) rapl_enable ;;
    rapl-revert) rapl_revert ;;
    sensors-detect) sensors_detect ;;
    sensors-revert) sensors_revert ;;
    polkit-rule)
        case "${2-}" in
            on) polkit_rule_on ;;
            off) polkit_rule_off ;;
            *) usage ;;
        esac
        ;;
    linger)
        case "${2-}" in
            on) linger enable ;;
            off) linger disable ;;
            *) usage ;;
        esac
        ;;
    remote-admin)
        case "${2-}" in
            on) remote_admin_on ;;
            off) remote_admin_off ;;
            state) remote_admin_state ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
