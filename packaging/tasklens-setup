#!/bin/sh
# tasklens-setup: the root steps of the Additional Setup window (E29-022, E29-023,
# R-138 item 11).
# The window runs it as `pkexec /usr/lib/tasklens/tasklens-setup <subcommand>`.
# Fixed paths only. Nothing is written to /tmp. /etc/udev/rules.d/99-powercap.rules is never
# read, written or removed (R-029).
#
# Test mode: when not root and TASKLENS_SETUP_ROOT is set, every path is under that root and
# external commands are printed as "would run: ..." instead of run. As root the variable is
# ignored (R-168 E29-OI-13).
set -eu
umask 022
PATH=/usr/bin:/bin
export PATH
# Byte ranges in the module name check, whatever the caller's locale.
LC_ALL=C
export LC_ALL

RULE='SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", ACTION=="add", RUN+="/usr/bin/chmod 0444 /sys%p/energy_uj"'
USAGE='usage: tasklens-setup rapl-enable|rapl-revert|sensors-detect|sensors-revert|polkit-rule on|off'

if [ "$(id -u)" -eq 0 ]; then
    ROOT=""
    TEST=0
elif [ -n "${TASKLENS_SETUP_ROOT-}" ]; then
    ROOT="$TASKLENS_SETUP_ROOT"
    TEST=1
else
    echo 'tasklens-setup: must run as root (use pkexec)' >&2
    exit 1
fi

RULES_DIR="$ROOT/etc/udev/rules.d"
MODULES_DIR="$ROOT/etc/modules-load.d"

# Runs an external system command, or prints it in test mode.
run() {
    if [ "$TEST" -eq 1 ]; then
        echo "would run: $*"
    else
        "$@"
    fi
}

udev_reload() {
    run udevadm control --reload
    run udevadm trigger --subsystem-match=powercap --action=add
}

rapl_enable() {
    tmp="$RULES_DIR/99-tasklens-powercap.rules.tmp"
    printf '%s\n' "$RULE" > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$RULES_DIR/99-tasklens-powercap.rules"
    udev_reload
    echo 'Enabled'
}

rapl_revert() {
    rm -f "$RULES_DIR/99-tasklens-powercap.rules"
    udev_reload
    echo 'Reverted. A reboot may be needed before the files return to mode 0400.'
}

# Runs `sensors-detect --auto`, or in test mode prints `$ROOT/sensors-detect.out`.
sensors_detect_output() {
    if [ "$TEST" -eq 1 ]; then
        echo 'would run: sensors-detect --auto'
        cat "$ROOT/sensors-detect.out"
    else
        sensors-detect --auto
    fi
}

# PERF-108: writes the modules sensors-detect finds to modules-load.d and loads them.
sensors_detect() {
    if [ ! -f "$ROOT/usr/bin/sensors-detect" ]; then
        echo 'Install lm_sensors to detect fan sensors'
        exit 3
    fi
    status=0
    out=$(sensors_detect_output) || status=$?
    printf '%s\n' "$out"
    if [ "$status" -ne 0 ]; then
        exit "$status"
    fi

    # Keep the value of every `MODULE_<digits>=` line. Only names of letters, digits, `_` and
    # `-` reach modprobe.
    modules=''
    nl='
'
    set -f
    saved_ifs=$IFS
    IFS=$nl
    for line in $out; do
        key=${line%%=*}
        [ "$key" != "$line" ] || continue
        case $key in
            MODULE_*) ;;
            *) continue ;;
        esac
        case ${key#MODULE_} in
            '' | *[!0-9]*) continue ;;
        esac
        name=${line#*=}
        case $name in
            \"*\") name=${name#\"}; name=${name%\"} ;;
            \'*\') name=${name#\'}; name=${name%\'} ;;
        esac
        case $name in
            '' | *[!A-Za-z0-9_-]*)
                printf 'skipped module name: %s\n' "$name"
                continue
                ;;
        esac
        modules="$modules$name$nl"
    done
    IFS=$saved_ifs
    set +f

    if [ -z "$modules" ]; then
        echo 'No sensor modules found'
        return 0
    fi
    tmp="$MODULES_DIR/tasklens-sensors.conf.tmp"
    printf '%s' "$modules" > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$MODULES_DIR/tasklens-sensors.conf"
    set -f
    IFS=$nl
    for name in $modules; do
        # `run` prints its arguments joined by the first IFS character.
        IFS=$saved_ifs
        run modprobe "$name"
    done
    IFS=$saved_ifs
    set +f
    echo 'Enabled'
}

sensors_revert() {
    rm -f "$MODULES_DIR/tasklens-sensors.conf"
    echo 'Reverted. The modules stay loaded until the next reboot.'
}

case "${1-}" in
    rapl-enable) rapl_enable ;;
    rapl-revert) rapl_revert ;;
    sensors-detect) sensors_detect ;;
    sensors-revert) sensors_revert ;;
    *)
        echo "$USAGE" >&2
        exit 2
        ;;
esac
