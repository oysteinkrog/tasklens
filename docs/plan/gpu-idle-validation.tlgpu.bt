// x12tr.5: per-minute NVIDIA RM and renderer counts for one tasklens pid, plus write-lock holds.
// Usage: bpftrace tlgpu.bt <pid> <draw-symbol> <present-symbol>   (uprobes use $4 = binary path)
kprobe:nvidia:nvidia_unlocked_ioctl /pid == $1/ { @ioctl++; }
kprobe:nvidia:nvos_create_alloc /pid == $1/ { @alloc++; }
kprobe:nvidia:nvidia_mmap_helper /pid == $1/ { @map++; }
kprobe:nvidia:nv_alloc_pages /pid == $1/ { @dmamap++; }
uprobe:$4:$2 /pid == $1/ { @draw++; }
uprobe:$4:$3 /pid == $1/ { @present++; }
kprobe:nvidia:os_acquire_rwlock_write /pid == $1/ { @lk[tid] = arg0; }
kretprobe:nvidia:os_acquire_rwlock_write /pid == $1 && @lk[tid]/ { @t0[tid] = nsecs; }
kprobe:nvidia:os_release_rwlock_write /pid == $1 && @t0[tid] && @lk[tid] == arg0/ {
  $d = (uint64)(nsecs - @t0[tid]) / 1000;
  @holds++;
  if ($d > @max_hold_us) { @max_hold_us = $d; }
  if ($d > 10000) { printf("HOLD>10ms %d us tid %d\n", $d, tid); print(kstack(12)); }
  delete(@t0[tid]); delete(@lk[tid]);
}
interval:s:60 {
  time("%H:%M:%S ");
  printf("ioctl=%d nvos_alloc=%d mmap=%d allocpages=%d draw=%d present=%d lockholds=%d max_hold_us=%d\n",
    @ioctl, @alloc, @map, @dmamap, @draw, @present, @holds, @max_hold_us);
  clear(@ioctl); clear(@alloc); clear(@map); clear(@dmamap); clear(@draw); clear(@present); clear(@holds); clear(@max_hold_us);
}
END { clear(@lk); clear(@t0); }
